# ===== 应用配置 =====
APP_NAME=rustpbx-community
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库配置 =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=rustpbx
MYSQL_PASSWORD=rustpbx_secret_123
MYSQL_DATABASE=rustpbx_community
MYSQL_ROOT_PASSWORD=root_secret_123

# ===== JWT 配置 =====
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== GitHub OAuth 配置 =====
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# ===== 腾讯云 COS 配置 =====
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-guangzhou
COS_BUCKET=rustpbx-community-1234567890
# CDN 加速域名（配置后图片走 CDN 返回，留空则用 COS 直连）
CDN_DOMAIN=

# ===== CORS 配置 =====
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
